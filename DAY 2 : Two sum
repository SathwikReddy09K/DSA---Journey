class solution:
    def two_sum(self,arr,n,target):
        dict={}
        for i in range(n):
            comp=target-arr[i]
            if comp in dict:
                return dict[comp],i
            num=arr[i]
            dict[num]=i
        return None      
s1=solution()
arr=[2,4,7,11,3,5]
print("original arrray:\n",arr)
n=len(arr)
target=int(input("Enter your's target:"))
ans=s1.two_sum(arr,n,target)
print("indxes of two sum array:",ans)

